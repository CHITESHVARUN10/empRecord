NODE_ENV=development
PORT=5050
MONGODB_URI=mongodb://127.0.0.1:27017/blaupunkt_employee_records
SESSION_SECRET=replace-with-a-64-character-random-string
SESSION_HOURS=8
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:5050
STORAGE_DRIVER=blob
BLOB_READ_WRITE_TOKEN=
BLOB_PREFIX=EMP records
GOOGLE_DRIVE_CREDENTIALS_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHARED_DRIVE_ID=
GOOGLE_DRIVE_ROOT_NAME=EMP records
LOCAL_UPLOAD_DIR=.uploads
MAX_FILE_SIZE_MB=5
UPLOAD_SESSION_HOURS=24
UPLOAD_TOKEN_MINUTES=15
CLEANUP_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=HR Administrator
SEED_ADMIN_ON_START=false
